# cache all ics files for 30 minutes
/**.ics
	cache-control: max-age=1800, no-transform, stale-while-revalidate, stale-if-error

# event pages and their JSON change with each build, like the calendars
/event/*
	cache-control: max-age=1800, no-transform, stale-while-revalidate, stale-if-error

# let other sites read the JSON API, cached like the calendars
/api/*
	access-control-allow-origin: *
	cache-control: max-age=1800, no-transform, stale-while-revalidate, stale-if-error

# rollup names chunks by content hash
/assets/js/chunks/*
	cache-control: public, max-age=31536000, immutable
